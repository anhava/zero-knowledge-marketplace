# Zero-Knowledge Marketplace Environment Configuration
# Copy this file to .env and update with your values

# ===========================================
# GENERAL CONFIGURATION
# ===========================================

# Environment: development, staging, production
NODE_ENV=production

# Primary domain for the control panel
DOMAIN=marketplace.example.com

# Email for Let's Encrypt SSL certificates
ACME_EMAIL=admin@example.com

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL connection
DB_USER=zkm_platform
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/zkm_platform?sslmode=require

# ===========================================
# REDIS CONFIGURATION
# ===========================================

REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_456!
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ===========================================
# SECURITY KEYS
# ===========================================

# JWT secret for API authentication (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_THIS_JWT_SECRET_789abc

# Encryption key for sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=CHANGE_THIS_ENCRYPTION_KEY_def012

# Blind signature keys for payment privacy
BLIND_SIGNATURE_PUBLIC_KEY=CHANGE_THIS_PUBLIC_KEY
BLIND_SIGNATURE_PRIVATE_KEY=CHANGE_THIS_PRIVATE_KEY

# Admin access token hash (generate token, then: echo -n "token" | sha256sum)
ADMIN_TOKEN_HASH=CHANGE_THIS_ADMIN_TOKEN_HASH

# ===========================================
# TOR CONFIGURATION
# ===========================================

# Enable Tor integration
TOR_ENABLED=true

# Tor control password
TOR_CONTROL_PASSWORD=CHANGE_THIS_TOR_PASSWORD_345

# Tor proxy settings
TOR_PROXY_HOST=tor-proxy
TOR_PROXY_PORT=9050

# ===========================================
# BTCPAY SERVER CONFIGURATION
# ===========================================

# Comma-separated list of BTCPay store IDs for payment processing
BTCPAY_STORE_POOL=store1,store2,store3

# Webhook secret for BTCPay callbacks
BTCPAY_WEBHOOK_SECRET=CHANGE_THIS_WEBHOOK_SECRET_678

# Default BTCPay configuration
BTCPAY_DEFAULT_NETWORK=mainnet
BTCPAY_DEFAULT_LIGHTNING=lnd

# ===========================================
# CRYPTOCURRENCY CONFIGURATION
# ===========================================

# Bitcoin node connection (for shops)
BTC_RPC_URL=http://bitcoin-node:8332
BTC_RPC_USER=bitcoinrpc
BTC_RPC_PASS=CHANGE_THIS_RPC_PASSWORD
BTC_ZMQ_BLOCK=tcp://bitcoin-node:28332
BTC_ZMQ_TX=tcp://bitcoin-node:28333

# ===========================================
# DEPLOYMENT CONFIGURATION
# ===========================================

# Docker socket path
DOCKER_HOST=/var/run/docker.sock

# Shop data storage path
SHOP_DATA_PATH=/data/shops

# Maximum shops per user
MAX_SHOPS_PER_USER=5

# ===========================================
# CORS CONFIGURATION
# ===========================================

# Comma-separated list of allowed origins
CORS_ORIGINS=https://marketplace.example.com,http://localhost:3000

# ===========================================
# MONITORING CONFIGURATION
# ===========================================

# Enable monitoring
MONITORING_ENABLED=true

# Prometheus metrics port
PROMETHEUS_PORT=9090

# ===========================================
# RATE LIMITING
# ===========================================

# API rate limits
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# OPTIONAL SERVICES
# ===========================================

# IPFS integration (optional)
IPFS_ENABLED=false
IPFS_API_URL=http://ipfs:5001

# Email notifications (optional, for ToS violations only)
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=CHANGE_THIS_SMTP_PASSWORD

# ===========================================
# LOGGING
# ===========================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log retention days
LOG_RETENTION_DAYS=7

# ===========================================
# BACKUP CONFIGURATION
# ===========================================

# Backup encryption key
BACKUP_ENCRYPTION_KEY=CHANGE_THIS_BACKUP_KEY

# S3 backup configuration (optional)
S3_BACKUP_ENABLED=false
S3_BACKUP_BUCKET=zkm-backups
S3_BACKUP_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_THIS_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_THIS_SECRET_KEY